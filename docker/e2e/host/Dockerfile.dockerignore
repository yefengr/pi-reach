# Root build context: include only Host image inputs.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!pwa/
!pwa/package.json
!pi-extension/
!pi-extension/package.json
!pi-extension/README.md
!pi-extension/LICENSE
!pi-extension/tsconfig.json
!pi-extension/src/
!pi-extension/src/**
!pi-extension/scripts/
!pi-extension/scripts/vendor-protocol.mjs
!packages/
!packages/protocol/
!packages/protocol/package.json
!packages/protocol/tsconfig.json
!packages/protocol/src/
!packages/protocol/src/**
!docker/
!docker/e2e/
!docker/e2e/host/
!docker/e2e/host/Dockerfile
!docker/e2e/host/interactive-controller.mjs
!docker/e2e/host/interactive-entrypoint.sh

# Defensive exclusions for sensitive or large material in the root context.
node_modules/
**/node_modules/
.pi/
**/.pi/
.env*
**/.env*
.git/
**/.git/
