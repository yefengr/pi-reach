{
  "name": "pwa",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "sync:install": "node scripts/sync-install-sh.mjs",
    "build": "pnpm --filter @pi-reach/protocol build && node scripts/sync-install-sh.mjs && vite build",
    "start": "node scripts/start-e2e-server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project node",
    "test:component": "vitest run --project browser --browser.fileParallelism=false",
    "test:component:production": "NODE_ENV=production vitest run --project browser --browser.fileParallelism=false src/components/pwa/service-worker-register.browser.test.tsx",
    "test:component:watch": "vitest --project browser --no-file-parallelism",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:component:production",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test --config playwright.remote.config.ts",
    "test:e2e:remote:list": "playwright test --config playwright.remote.config.ts --list",
    "test:e2e:ui": "playwright test --ui",
    "start:e2e-server": "node scripts/start-e2e-server.mjs",
    "screenshots": "pnpm --filter @pi-reach/protocol build && vitest run --config vitest.screenshots.config.ts"
  },
  "dependencies": {
    "@mantine/core": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@mantine/notifications": "9.5.2",
    "@noble/ed25519": "catalog:",
    "@pi-reach/protocol": "workspace:*",
    "@zxing/browser": "^0.2.1",
    "dexie": "^4.4.5",
    "highlight.js": "11.12.0",
    "lucide-react": "^1.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@serwist/vite": "9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "catalog:pwa",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "serwist": "9.5.12",
    "tailwindcss": "^4",
    "typescript": "catalog:pwa",
    "typescript-eslint": "8.59.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.2.0"
  }
}
