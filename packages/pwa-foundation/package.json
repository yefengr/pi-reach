{
  "name": "@yefengr/pwa-foundation",
  "version": "0.0.4",
  "description": "Shared safe-area utilities, theme tokens and Mantine controls for React PWAs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yefengr/pi-reach.git",
    "directory": "packages/pwa-foundation"
  },
  "bugs": "https://github.com/yefengr/pi-reach/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./foundation.css": "./foundation.css",
    "./theme.css": "./theme.css",
    "./controls.css": "./controls.css",
    "./surfaces.css": "./surfaces.css",
    "./mantine": { "types": "./dist/mantine.d.ts", "default": "./dist/mantine.js" }
  },
  "files": ["dist", "foundation.css", "theme.css", "controls.css", "surfaces.css", "CHANGELOG.md", "DESIGN.md"],
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm build && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "@mantine/core": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "lucide-react": "1.33.0"
  },
  "peerDependenciesMeta": {
    "@mantine/core": { "optional": true },
    "@mantine/hooks": { "optional": true },
    "lucide-react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@mantine/core": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "lucide-react": "1.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
