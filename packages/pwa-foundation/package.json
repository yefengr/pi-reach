{
  "name": "@yefengr/pwa-foundation",
  "version": "0.0.1",
  "description": "Shared safe-area CSS tokens and floating overlay middleware for React PWAs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yefengr/pi-reach.git",
    "directory": "packages/pwa-foundation"
  },
  "homepage": "https://github.com/yefengr/pi-reach/tree/pwa-foundation-v0.0.1/packages/pwa-foundation",
